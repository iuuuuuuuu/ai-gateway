# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust / Tauri 构建产物（workspace target）
# target-* 覆盖 CARGO_TARGET_DIR 指向的自定义目录（如 target-check/），
# 单纯的 target/ 不匹配它们，会漏进 git status。
target/
target-*/
src-tauri/target/

# npm 包 postinstall 下载的平台二进制
npm/bin/ai-gateway-*

# 本地运行时数据
accounts.json
backups/

# Editor directories and files
.vscode/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
npm/platform/*/bin/

# AI 工具本地配置
.codebuddy/
.cursor/
.agents/
.codex/
.grok/
/.workbuddy/

# 内嵌网关二进制（构建产物，由 scripts/build-gateway 生成）
crates/ai-gateway-core/embedded/

# 单文件构建产物（不入库，改由 CI/本地构建生成）
dist-single/
_rel/

# CI 工作流已纳入版本管理（.github/workflows/）。
# 注意：推送工作流文件需要 GitHub token 具备 workflow scope。

# 更新签名私钥（绝不入库；丢失后无法签名新版本）
*.key
*.key.pub
!.gitignore

# AI 助手的本机仓库导航备忘（只在本地用，不入库）
NAVIGATION.md

# Python 缓存（仓库根出现过 __pycache__/*.pyc 被误加进暂存区）
__pycache__/
*.pyc

# 本地隔离测试实例的 Tauri 配置（独立 identifier + 数据目录，仅供开发调试）
src-tauri/tauri.dev-sandbox.conf.json

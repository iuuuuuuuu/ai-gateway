{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the hidden captcha solver windows",
  "windows": ["main", "captcha-solve-*", "captcha-warmup"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "updater:default",
    "notification:default",
    "dialog:default",
    "dialog:allow-save"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Gateway",
  "version": "1.0.9-beta.1",
  "identifier": "com.momo0410.aigateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Gateway · 账号管理 + 兼容网关",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "WebView2Loader.dll",
      "../assets/zcode-captcha"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGQTNDMzZGNEJFNjdDN0UKUldSK2ZPWkxiOE9qYjQxeDN2T2hlMklRb2pjNXM0N0ZjckMxVVh1bHYrdWVKVGZJUnRBWVV1SmcK",
      "endpoints": [
        "https://github.com/iuuuuuuuu/ai-gateway/releases/latest/download/latest.json",
        "https://github.com/iuuuuuuuu/ai-gateway/releases/latest/download/latest-{{target}}-{{arch}}.json"
      ]
    }
  }
}
